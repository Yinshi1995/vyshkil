/target
/migration/target
.env
node_modules
# Локально завантажений бінарник wasm-opt для Dockerfile (обхід нестабільного download у контейнері) — не в git.
/.docker-tools

# Дані замовника з грифом ДСК — ніколи в git (docs/spec/00-agent-brief.md, §0.8).
/source_files
*.log
# Збережені файли застосунку на сервері (stored_file, генеровані документи) — не в git.
/data

# Особисті дозволи користувача — не спільні (docs/spec/00-agent-brief.md, §0.5).
/.claude/settings.local.json

# Скріншоти/снапшоти Playwright MCP — сесійні артефакти, не для git.
/.playwright-mcp

# Артефакти запуску e2e-тестів (Етап 4) — репорти/трейси, не результати самих тестів.
/e2e/test-results
/e2e/playwright-report

# Інфраструктура (docs/spec/10-dev-vm.md §4.7) — секрети Ansible Vault ніколи в git:
# пароль vault-у, розшифрований vault.yml і будь-які .retry/.log з реальних прогонів.
/infra/ansible/.vault-pass
/infra/ansible/inventories/*/group_vars/vault.yml
*.retry
