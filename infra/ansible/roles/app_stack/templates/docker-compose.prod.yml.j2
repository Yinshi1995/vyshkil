# Прод compose — згенеровано Ansible (roles/app_stack). Не редагувати вручну.
# Мережі: internal (без інтернету), publish (локальний bridge без NAT), egress (notifier → WhatsApp),
# iks (app → ІКС/Pocket ID: лише HTTPS на проксі *.lab, решту ріже nftables хоста — roles/firewall).
networks:
  internal:
    internal: true
  publish:
    driver: bridge
    driver_opts:
      com.docker.network.bridge.enable_ip_masquerade: "false"
  egress:
    driver: bridge
{% if app_stack_iks_subnet %}
  iks:
    driver: bridge
    ipam:
      config:
        - subnet: {{ app_stack_iks_subnet }}
{% endif %}

services:
  db:
    image: postgres:16-alpine
    networks: [internal, publish]
    env_file: db.env
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
      - taktoblik_pgdata:/var/lib/postgresql/data
      - ./docker/init-notifier-db.sql:/docker-entrypoint-initdb.d/init-notifier-db.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ app_stack_postgres_app_user }}"]
      interval: 5s
      timeout: 3s
      retries: 15
    restart: unless-stopped
    logging:
      driver: local
      options:
        max-size: "10m"
        max-file: "3"

  nats:
    image: nats:2-alpine
    command: ["-c", "/etc/nats/nats-server.conf"]
    mem_limit: 256m
    networks: [internal, publish]
    volumes:
      - taktoblik_natsdata:/data
      - ./docker/nats-server.conf:/etc/nats/nats-server.conf:ro
    ports:
      - "127.0.0.1:4222:4222"
      - "127.0.0.1:8222:8222"
    restart: unless-stopped
    logging:
      driver: local
      options:
        max-size: "10m"
        max-file: "3"

  app:
    image: vyshkil-app:latest
{% if app_stack_iks_subnet %}
    # Маршрут за замовчуванням — через iks (publish без NAT); назовні з iks пускає лише ІКС.
    networks:
      internal: {}
      publish: {}
      iks:
        gw_priority: 1
    # ІКС без DNS у контейнері: адреса проксі *.lab — прямо тут.
    extra_hosts:
      - "{{ app_stack_oidc_host }}:{{ app_stack_iks_proxy_ip }}"
{% else %}
    networks: [internal, publish]
{% endif %}
    depends_on:
      db:
        condition: service_healthy
      nats:
        condition: service_started
    env_file: app.env
    ports:
      - "{{ app_stack_app_bind_addr }}:3000:3000"
    volumes:
      # Сервер пише у відносний data/ (avatars, chat-media, generated_documents), WORKDIR /app.
      - app_data:/app/data
    restart: unless-stopped
    logging:
      driver: local
      options:
        max-size: "10m"
        max-file: "3"

  notifier:
    image: vyshkil-notifier:latest
    networks: [internal, egress]
    mem_limit: 1g
    shm_size: 512m
    cap_add:
      - SYS_ADMIN
    depends_on:
      db:
        condition: service_healthy
      nats:
        condition: service_started
    env_file: notifier.env
    volumes:
      - taktoblik_wa_session:/app/wa-session
    restart: unless-stopped
    logging:
      driver: local
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  taktoblik_pgdata:
  taktoblik_natsdata:
  taktoblik_wa_session:
  app_data:
