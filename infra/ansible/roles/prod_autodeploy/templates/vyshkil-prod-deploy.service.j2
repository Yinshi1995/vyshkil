# Згенеровано Ansible (roles/prod_autodeploy). Журнал: journalctl -u vyshkil-prod-deploy
[Unit]
Description=vyshkil: деплой origin/{{ prod_autodeploy_branch }} (якщо є новий коміт)
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=REPO_URL={{ prod_autodeploy_repo_url }}
Environment=BRANCH={{ prod_autodeploy_branch }}
Environment=STATE_DIR={{ prod_autodeploy_state_dir }}
Environment=PROD_DIR={{ app_stack_compose_dir }}
Environment=HEALTH_URL=http://{{ app_stack_app_bind_addr }}:3000/
Environment=BUILDER={{ prod_autodeploy_builder }}
ExecStart={{ prod_autodeploy_script }}
TimeoutStartSec=90min
Nice=10
