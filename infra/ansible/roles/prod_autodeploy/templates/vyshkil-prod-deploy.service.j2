# Згенеровано Ansible (roles/prod_autodeploy). Журнал: journalctl -u vyshkil-prod-deploy
[Unit]
Description=vyshkil: оновлення з GHCR :{{ prod_autodeploy_channel }} (якщо є новий коміт)
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=REGISTRY={{ prod_autodeploy_registry }}
Environment=CHANNEL={{ prod_autodeploy_channel }}
Environment=STATE_DIR={{ prod_autodeploy_state_dir }}
Environment=PROD_DIR={{ app_stack_compose_dir }}
Environment=HEALTH_URL=http://{{ app_stack_app_bind_addr }}:3000/
ExecStart={{ prod_autodeploy_script }}
TimeoutStartSec=20min
