# Шаблон. Реальний файл — vault.yml, зашифрований `ansible-vault encrypt`, НЕ в git.
#
# Створення:
#   ansible-vault create inventories/prod/group_vars/vault.yml

# Proxmox API (якщо потрібний provision з токеном)
vault_pve_api_token_id: "ansible@pve!provision"
vault_pve_api_token_secret: "СЕКРЕТ-ТОКЕНА-СЮДИ"

# Postgres
vault_postgres_app_password: "ЗГЕНЕРУВАТИ-СТІЙКИЙ-ПАРОЛЬ"
vault_postgres_notifier_password: "ЗГЕНЕРУВАТИ-СТІЙКИЙ-ПАРОЛЬ"

# NATS
vault_nats_app_password: "ЗГЕНЕРУВАТИ-СТІЙКИЙ-ПАРОЛЬ"
vault_nats_notifier_password: "ЗГЕНЕРУВАТИ-СТІЙКИЙ-ПАРОЛЬ"
