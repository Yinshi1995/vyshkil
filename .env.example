# Скопіюй у .env і заповни реальними значеннями — .env навмисно в .gitignore, щоб паролі не потрапили в git.

# Формат postgres://user:password@host:port/dbname — той самий рядок читає і sea-orm-cli, і server.
DATABASE_URL=postgres://taktoblik:taktoblik@localhost:5432/taktoblik

# Малий пул на слабкому сервері: кожне з'єднання Postgres — це окремий процес на боці БД (~кілька МБ RAM).
DATABASE_MAX_CONNECTIONS=5

# Кількість воркер-потоків tokio; тримай <= фізичних ядер сервера, щоб не плодити зайві стеки потоків.
SERVER_WORKER_THREADS=2

# Адреса/порт беруться з [[workspace.metadata.leptos]].site-addr, але можна перекрити змінною LEPTOS_SITE_ADDR.
LEPTOS_SITE_ADDR=0.0.0.0:3000

# Рівень логування tracing: у продакшені тримаємо "info", sqlx окремо приглушений через шум запитів.
RUST_LOG=info,sqlx=warn

# Брокер (09-messaging.md, Фаза 1) -- relay сам ретраїть з'єднання, якщо NATS недоступний при
# старті (§3.1: "NATS недоступний -> застосунок працює як завжди"), тому не обов'язковий для
# локального запуску без брокера, якщо просто лишити дефолт нижче непіднятим.
NATS_URL=nats://127.0.0.1:4222

# Вхід через ІКС (OIDC, Pocket ID) — 12-auth.md §2.5. Усі п'ять або жодної (тоді кнопки
# «Увійти через ІКС» немає). Секрет клієнта — лише в .env на сервері, НЕ в git.
OIDC_ISSUER=https://id.lab.okpivden.uk
OIDC_CLIENT_ID=vyshkil
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://vyshkil.lab.okpivden.uk/api/auth/oidc/callback
OIDC_GROUP=vyshkil

# Аварійний вхід за паролем (і зміна/скидання пароля, «Запросити обліковий запис»).
# За замовчуванням вимкнено — штатний вхід лише через ІКС. Увімкнути: PASSWORD_LOGIN=1.
PASSWORD_LOGIN=0
