{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnvelopeNotifySendV1",
  "type": "object",
  "properties": {
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "$ref": "#/$defs/NotifySend"
    },
    "producer": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "producer",
    "correlation_id",
    "payload"
  ],
  "$defs": {
    "NotifySend": {
      "type": "object",
      "properties": {
        "dedupe_key": {
          "type": "string"
        },
        "recipient_org_id": {
          "type": "integer",
          "format": "int64"
        },
        "template": {
          "$ref": "#/$defs/NotifyTemplate"
        }
      },
      "required": [
        "recipient_org_id",
        "template",
        "dedupe_key"
      ]
    },
    "NotifyTemplate": {
      "description": "Шаблон сповіщення — сам текст (знеособлений, 04 §5) рендерить `notifier` за цим варіантом,\nне отримує його рядком через брокер.",
      "type": "string",
      "enum": [
        "discrepancy_detected",
        "discrepancy_resolved",
        "import_completed",
        "submission_committed",
        "group_event_added"
      ]
    }
  }
}
